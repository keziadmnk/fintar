# FinTar Environment Variables Example
# Copy this file to .env.local and fill in your actual credentials:
# cp .env.example .env.local

# -----------------------------------------------------------------------------
# Frontend Client Configuration (Vite)
# -----------------------------------------------------------------------------
# Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Public Anon Key (safe for browser client)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# -----------------------------------------------------------------------------
# Supabase Edge Functions Secrets (Set via: npx supabase secrets set KEY=VALUE)
# -----------------------------------------------------------------------------
# LLM Provider: "gemini" (default), "anthropic", or "mock" (offline test)
LLM_PROVIDER=gemini

# Google Gemini Free Tier API Key (from https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: Specific Gemini model override (defaults to gemini-1.5-flash)
LLM_MODEL=gemini-1.5-flash

# Optional: Anthropic API Key (if LLM_PROVIDER=anthropic)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
